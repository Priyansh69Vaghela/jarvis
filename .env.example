# ==========================================
# JARVIS AI - Environment Configuration
# ==========================================

# 1. Google Gemini API Key (Brain & Reasoning - Free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud API Key (Fast Speech-to-Text - Free at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# 3. Voice Settings (Microsoft Edge Neural Voices)
# Options: en-US-ChristopherNeural, en-US-GuyNeural, en-GB-RyanNeural, en-US-EricNeural
JARVIS_VOICE=en-US-ChristopherNeural
JARVIS_VOICE_RATE=+5%
JARVIS_VOICE_PITCH=+0Hz
